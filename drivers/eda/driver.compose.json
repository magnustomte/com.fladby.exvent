  "pair": [
    {
      "id": "start"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "EDA settings",
        "no": "EDA-innstillinger"
      },
      "children": [
        {
          "id": "address",
          "type": "text",
          "value": "0.0.0.0",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          }
        },
        {
          "id": "port",
          "type": "number",
          "value": 502,
          "step": 1,
          "label": {
            "en": "Port",
            "no": "Port"
          }
        },
        {
          "id": "unitId",
          "type": "number",
          "value": 1,
          "min": 1,
          "max": 255,
          "step": 1,
          "label": {
            "en": "Modbus slave ID",
            "no": "Modbus slave-ID"
          },
          "hint": {
            "en": "A Freeway WEB adapter presents the unit on slave ID 1. Only change this if your setup differs.",
            "no": "En Freeway WEB-adapter presenterer aggregatet på slave-ID 1. Endre kun hvis oppsettet ditt avviker."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Ventilation unit",
        "no": "Ventilasjonsaggregat"
      },
      "children": [
        {
          "id": "overpressure_duration",
          "type": "number",
          "value": 10,
          "min": 1,
          "max": 60,
          "step": 1,
          "units": {
            "en": "min"
          },
          "label": {
            "en": "Overpressure duration",
            "no": "Varighet for overtrykk"
          },
          "hint": {
            "en": "How long overpressure runs before the unit returns to normal. Stored on the unit, and also changed if you set it on the unit's panel.",
            "no": "Hvor lenge overtrykk varer før aggregatet går tilbake til normal drift. Lagres på aggregatet, og endres også hvis du setter den på panelet."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Season control",
        "no": "Sesongstyring"
      },
      "children": [
        {
          "id": "heating_allowed",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Heating allowed",
            "no": "Varme tillatt"
          },
          "hint": {
            "en": "Whether the unit may heat the supply air. Turn off in summer so a cold night does not start heating. Stored on the unit.",
            "no": "Om aggregatet får varme tilluften. Slå av om sommeren, så en kald natt ikke starter oppvarming. Lagres på aggregatet."
          }
        },
        {
          "id": "cooling_allowed",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Cooling allowed",
            "no": "Kjøling tillatt"
          },
          "hint": {
            "en": "Whether the unit may cool the supply air. Turn off outside summer so a warm spell does not start cooling. Stored on the unit.",
            "no": "Om aggregatet får kjøle tilluften. Slå av utenom sommeren, så en varm periode ikke starter kjøling. Lagres på aggregatet."
          }
        },
        {
          "id": "heating_block_temperature",
          "type": "number",
          "value": 25,
          "min": -5,
          "max": 25,
          "step": 0.5,
          "units": {
            "en": "°C"
          },
          "label": {
            "en": "Block heating above",
            "no": "Sperr varme over"
          },
          "hint": {
            "en": "Heating is blocked while the outdoor temperature is above this. Stored on the unit.",
            "no": "Varme sperres så lenge utetemperaturen er over denne grensen. Lagres på aggregatet."
          }
        },
        {
          "id": "cooling_block_temperature",
          "type": "number",
          "value": 16,
          "min": 5,
          "max": 40,
          "step": 0.5,
          "units": {
            "en": "°C"
          },
          "label": {
            "en": "Block cooling below",
            "no": "Sperr kjøling under"
          },
          "hint": {
            "en": "Cooling is blocked while the outdoor temperature is below this. Stored on the unit.",
            "no": "Kjøling sperres så lenge utetemperaturen er under denne grensen. Lagres på aggregatet."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Service reminder",
        "no": "Servicepåminnelse"
      },
      "children": [
        {
          "id": "service_reminder",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Service reminder",
            "no": "Servicepåminnelse"
          },
          "hint": {
            "en": "Whether the unit raises a B alarm reminding you to service it and change the filters. Stored on the unit.",
            "no": "Om aggregatet gir en B-alarm som minner deg på service og filterbytte. Lagres på aggregatet."
          }
        },
        {
          "id": "service_reminder_interval",
          "type": "number",
          "value": 180,
          "min": 1,
          "max": 365,
          "step": 1,
          "units": {
            "en": "days",
            "no": "døgn"
          },
          "label": {
            "en": "Interval",
            "no": "Intervall"
          },
          "hint": {
            "en": "Days between reminders. Enervent recommends changing the filters every six months. Stored on the unit.",
            "no": "Døgn mellom hver påminnelse. Enervent anbefaler filterbytte hvert halvår. Lagres på aggregatet."
          }
        }
      ]
    }
  ]
}
