{
  "actions": [
    {
      "id": "heatingcoil_freeway",
      "title": {
        "en": "Set heating",
        "no": "Sett varme"
      },
      "titleFormatted": {
        "en": "Set heating to [[heatingcoil]]",
        "no": "Sett varme til [[heatingcoil]]"
      },
      "hint": {
        "en": "Allows or blocks heating of the supply air. Stored on the unit.",
        "no": "Tillater eller sperrer oppvarming av tilluften. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "heatingcoil",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "allowed",
                "no": "tillatt"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "blocked",
                "no": "sperret"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-temperature_freeway",
      "title": {
        "en": "Set target temperature",
        "no": "Sett ønsket temperatur"
      },
      "titleFormatted": {
        "en": "Set target temperature to [[temperature]]",
        "no": "Sett ønsket temperatur til [[temperature]]"
      },
      "hint": {
        "en": "Sets the temperature the unit regulates towards.",
        "no": "Setter temperaturen aggregatet regulerer mot."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 10,
          "max": 30,
          "step": 1,
          "label": "°C"
        }
      ]
    },
    {
      "id": "status-mode_freeway",
      "title": {
