      "hint": {
        "en": "Sets the ventilation mode.",
        "no": "Setter ventilasjonsmodus."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "mode",
          "values": [
            {
              "id": "0",
              "label": {
                "en": "Home",
                "no": "Hjemme"
              }
            },
            {
              "id": "1",
              "label": {
                "en": "Away",
                "no": "Borte"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Overpressure",
                "no": "Overtrykk"
              }
            },
            {
              "id": "3",
              "label": {
                "en": "Boost",
                "no": "Boost"
              }
            },
            {
              "id": "4",
              "label": {
                "en": "Off",
                "no": "Av"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-overpressure-duration_freeway",
      "title": {
        "en": "Set overpressure duration",
        "no": "Sett varighet for overtrykk"
      },
      "titleFormatted": {
        "en": "Set overpressure duration to [[minutes]]",
        "no": "Sett varighet for overtrykk til [[minutes]]"
      },
      "hint": {
        "en": "How long overpressure runs before the unit returns to normal. Stored on the unit.",
        "no": "Hvor lenge overtrykk varer før aggregatet går tilbake til normal drift. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "label": "min"
        }
      ]
    },
    {
      "id": "set-cooling_freeway",
      "title": {
        "en": "Set cooling",
        "no": "Sett kjøling"
      },
      "titleFormatted": {
        "en": "Set cooling to [[allowed]]",
        "no": "Sett kjøling til [[allowed]]"
      },
      "hint": {
        "en": "Allows or blocks cooling of the supply air. Stored on the unit.",
        "no": "Tillater eller sperrer kjøling av tilluften. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "allowed",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "allowed",
                "no": "tillatt"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "blocked",
                "no": "sperret"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-heating-block-temperature_freeway",
      "title": {
        "en": "Block heating above",
        "no": "Sperr varme over"
      },
      "titleFormatted": {
        "en": "Block heating above [[temperature]]",
        "no": "Sperr varme over [[temperature]]"
      },
      "hint": {
        "en": "Heating is blocked while the outdoor temperature is above this. Stored on the unit.",
        "no": "Varme sperres så lenge utetemperaturen er over denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": -5,
          "max": 25,
          "step": 0.5,
          "label": "°C"
        }
      ]
    },
    {
      "id": "set-cooling-block-temperature_freeway",
      "title": {
        "en": "Block cooling below",
        "no": "Sperr kjøling under"
      },
      "titleFormatted": {
        "en": "Block cooling below [[temperature]]",
        "no": "Sperr kjøling under [[temperature]]"
      },
      "hint": {
        "en": "Cooling is blocked while the outdoor temperature is below this. Stored on the unit.",
        "no": "Kjøling sperres så lenge utetemperaturen er under denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 5,
          "max": 40,
          "step": 0.5,
          "label": "°C"
        }
      ]
    }
